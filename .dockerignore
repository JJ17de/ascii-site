# Only the sources the Dockerfile copies are needed; keep everything else
# (build outputs, local tooling, reports, git history) out of the context.
.git
.github
.venv
**/__pycache__
*.pyc
.DS_Store
bin/
build/
dist/
tests/
server/web/*
!server/web/.gitkeep
CLAUDE-SECURITY-*
preview.png
setup.command
*.md
